# Copy this file to .env.local for local development, and set the same
# keys in your Vercel project's Environment Variables for deployment.
# Never commit .env.local or any file containing real secrets.

# ── Admin panel (/admin) ────────────────────────────────────────────
# Required. Password checked on the login form, and the secret used to
# sign the session cookie. Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Content persistence in production ───────────────────────────────
# Content lives in the content/*.json files. Locally, /admin writes
# straight to disk. On Vercel (no writable, persistent filesystem), set
# these so saves instead commit the updated file to your GitHub repo,
# which triggers a redeploy with the change live a short while later.
# Leave unset locally — local dev always writes to disk directly.
#   GITHUB_TOKEN  → a fine-grained PAT with Contents: Read and write on this repo
#   GITHUB_REPO   → "owner/repo", e.g. iako-digital/Mania-web
#   GITHUB_BRANCH → defaults to "main"
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# ── Cloudinary (image/video uploads in /admin) ──────────────────────
# Lets you upload a file directly from /admin instead of pasting a URL.
# Unsigned upload, so only the cloud name + upload preset (both public,
# NEXT_PUBLIC_) are needed client-side; the API key/secret aren't used
# by the upload itself but are kept here for any future signed/admin
# Cloudinary operations. Uploaded files are served straight from
# Cloudinary's CDN — the site never writes them to its own filesystem.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auto-translation (optional, recommended) ────────────────────────
# Used for two things: (1) the admin panel's Georgian-only bilingual
# fields auto-translate into English on save when this is set (leave
# unset and saves still work — English just stays blank until typed in
# by hand); (2) the site's AI chat assistant (/admin/ai-assistant edits
# its knowledge base). Free key: https://aistudio.google.com/apikey
# (sign in with a Google account, "Create API key" — no cost at this
# usage level).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ── Resend (optional) ───────────────────────────────────────────────
# If set, /api/contact emails new inquiries. Every submission is also
# always logged server-side regardless, so this is optional.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=Vashakidzemania@gmail.com

# ── Bunny Stream (course video hosting, /admin/courses) ─────────────
# Used by /api/admin/bunny-upload to create a video entry and sign a TUS
# resumable-upload credential set, and by the student /learning player to
# build the playback embed URL. Get these from your Bunny Stream library's
# API page: https://dash.bunny.net/stream/<library-id>/api
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# ── Manual bank-transfer checkout (courses + patterns) ───────────────
# Checkout is manual-transfer only for now: a buy button creates a
# "pending_payment" order (content/orders.json) and sends the student to
# /checkout/manual-transfer, which shows these account details. The student
# then uploads a receipt at /dashboard/manual-payments, and Mania approves
# it at /admin/verifications to grant access. Swapping this for an
# automated BOG/TBC gateway checkout is a separate future integration.
BOG_ACCOUNT_IBAN=
TBC_ACCOUNT_IBAN=
BANK_ACCOUNT_HOLDER_NAME=

# ── Database (prisma/schema.prisma — design-only, not connected yet) ───
# The app currently runs entirely on the content/*.json files; nothing
# reads DATABASE_URL at runtime. This is here so `npx prisma generate`
# validates the schema. To actually migrate: create a free Supabase
# project (supabase.com → New project), then Project Settings → Database
# → Connection string ("URI" tab, use the pooled "Transaction" mode
# connection for serverless) and paste it below.
DATABASE_URL=

# ── Google sign-in (Auth.js, /dashboard — optional) ─────────────────
# Without these, the dashboard keeps working as the demo student (same
# graceful-degrade pattern as the other optional integrations above).
# Setup: console.cloud.google.com → new project → "OAuth consent screen"
# (External, add your email as a test user) → "Credentials" → "Create
# Credentials" → "OAuth client ID" → Application type "Web application" →
# Authorized redirect URIs: add BOTH
#   http://localhost:3000/api/auth/callback/google
#   https://mania.com.ge/api/auth/callback/google
# Then copy the Client ID / Client secret below. Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
