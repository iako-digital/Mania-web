# Copy this file to .env.local for local development, and set the same
# keys in your Vercel project's Environment Variables for deployment.
# Never commit .env.local or any file containing real secrets.

# ── Sanity ──────────────────────────────────────────────────────────
# Create a project at https://www.sanity.io/manage (or run `npx sanity init`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-side write token (Manage → API → Tokens → Add API token → "Editor").
# Required so /api/contact can save inquiries as "Message" documents visible
# in the Studio. The public site only READS published content, and Sanity
# datasets are readable without a token by default, so no separate read
# token is needed unless you later make the dataset private.
SANITY_API_WRITE_TOKEN=

# ── Resend (optional) ───────────────────────────────────────────────
# If set, /api/contact also emails new inquiries in addition to saving
# them in the Studio. Leave blank to rely on the Studio "Messages" list only.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=Vashakidzemania@gmail.com
