# Copy this file to .env.local for local development, and set the same
# keys in your Vercel project's Environment Variables for deployment.
# Never commit .env.local or any file containing real secrets.

# ── Admin panel (/admin) ────────────────────────────────────────────
# Required. Password checked on the login form, and the secret used to
# sign the session cookie. Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Content persistence in production ───────────────────────────────
# Content lives in the content/*.json files. Locally, /admin writes
# straight to disk. On Vercel (no writable, persistent filesystem), set
# these so saves instead commit the updated file to your GitHub repo,
# which triggers a redeploy with the change live a short while later.
# Leave unset locally — local dev always writes to disk directly.
#   GITHUB_TOKEN  → a fine-grained PAT with Contents: Read and write on this repo
#   GITHUB_REPO   → "owner/repo", e.g. iako-digital/Mania-web
#   GITHUB_BRANCH → defaults to "main"
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# ── Cloudinary (image/video uploads in /admin) ──────────────────────
# Lets you upload a file directly from /admin instead of pasting a URL.
# Unsigned upload, so only the cloud name + upload preset (both public,
# NEXT_PUBLIC_) are needed client-side; the API key/secret aren't used
# by the upload itself but are kept here for any future signed/admin
# Cloudinary operations. Uploaded files are served straight from
# Cloudinary's CDN — the site never writes them to its own filesystem.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auto-translation (optional, recommended) ────────────────────────
# The admin panel is entirely in Georgian. In every bilingual field, if
# you fill in only the Georgian side and leave English blank, saving the
# form automatically translates it into English via Gemini. Leave this
# unset and saves still work — English just stays blank until typed in
# by hand. Free key: https://aistudio.google.com/apikey (sign in with a
# Google account, "Create API key" — no cost for this level of usage).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Resend (optional) ───────────────────────────────────────────────
# If set, /api/contact emails new inquiries. Every submission is also
# always logged server-side regardless, so this is optional.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=Vashakidzemania@gmail.com
